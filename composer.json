{
    "name": "fabiotech/laravel-elasticemail",
    "description": "A production-ready Elastic Email API transport for Laravel Mail.",
    "keywords": [
        "elastic email",
        "email",
        "laravel",
        "mailer",
        "transport"
    ],
    "homepage": "https://github.com/FabioTECH1/laravel-elasticemail",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "FabioTech"
        }
    ],
    "require": {
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-json": "*",
        "php": "^8.3",
        "elasticemail/elasticemail-php": "^4.2",
        "guzzlehttp/guzzle": "^7.15.2",
        "guzzlehttp/psr7": "^2.13.0",
        "illuminate/mail": "^12.61.1 || ^13.12.0",
        "illuminate/support": "^12.61.1 || ^13.12.0",
        "psr/log": "^1.0 || ^2.0 || ^3.0",
        "psr/http-message": "^1.0 || ^2.0",
        "symfony/mailer": "^7.4.13 || ^8.0.13",
        "symfony/mime": "^7.4.13 || ^8.0.13"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.22",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.8 || ^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "FabioTech\\LaravelElasticEmail\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FabioTech\\LaravelElasticEmail\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint --format agent",
        "test": "pest --compact"
    },
    "support": {
        "issues": "https://github.com/FabioTECH1/laravel-elasticemail/issues",
        "security": "https://github.com/FabioTECH1/laravel-elasticemail/security/advisories/new",
        "source": "https://github.com/FabioTECH1/laravel-elasticemail"
    },
    "extra": {
        "laravel": {
            "providers": [
                "FabioTech\\LaravelElasticEmail\\ElasticEmailServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
